# CDP Configuration for the main app
EXPO_PUBLIC_CDP_PROJECT_ID=YOUR_PROJECT_ID
# iOS App Attest App ID in teamID.bundleID form (allowlisted in the CDP project).
# MUST match the build's signing: teamID == Xcode DEVELOPMENT_TEAM and the
# bundle id == app.config.ts ios.bundleIdentifier. Required for app2app.
EXPO_PUBLIC_APP_ATTEST_APP_ID=TEAMID.com.your.bundle
# Android App2App package name is fixed in app.config.ts as
# com.coinbase.cdp_onramp — register that package (+ Play Integrity cloud
# project number) on the CDP project (portal allowlist — COM2-3687). The Google
# Cloud project number used by Play Integrity is typically supplied by the
# portal/project config once the Android entry is registered; no separate
# EXPO_PUBLIC_* override is required for the openCoinbaseOnramp path.
# CDP project that owns the app2app onramp integration (attestation + onramp
# mobile endpoints). Defaults to EXPO_PUBLIC_CDP_PROJECT_ID when unset.
EXPO_PUBLIC_ONRAMP_PROJECT_ID=YOUR_ONRAMP_PROJECT_ID

# Backend base URL. For the Vercel deployment this MUST end in /api (Vercel
# function routing), e.g. https://<project>.vercel.app/api. For a local server
# use http://BACKEND_SERVER:3000 (no /api suffix).
EXPO_PUBLIC_BASE_URL=http://BACKEND_SERVER:3000

# Optional: explicit app2app return (redirect) URL. Must be a host in the CDP
# project's redirect allowlist AND carry AASA (iOS) / Digital Asset Links
# (Android) so Coinbase can reopen us. Only needed when the API base above is
# NOT the public app domain — e.g. when proxying API traffic through a tunnel
# for debugging. When unset, the redirect is derived from the https origin of
# EXPO_PUBLIC_BASE_URL (falling back to the onrampdemo:// scheme).
# EXPO_PUBLIC_APP2APP_REDIRECT_URL=https://<project>.vercel.app/onramp-return

# Crypto implementation selector. THIS MATTERS FOR APP2APP / DEVICE ATTESTATION:
# - true  -> Expo Go (npx expo start): uses expo-crypto. App Attest / Play
#            Integrity return MOCK / unsupported results — app2app will NOT work.
# - false -> Native/dev/TestFlight/Play builds (npx expo run:ios|android):
#            uses react-native-quick-crypto + real attestation modules.
# Any distributable build MUST set this to false.
EXPO_PUBLIC_USE_EXPO_CRYPTO=true

# Optional: verbose client-side app2app / attestation debug logging.
# Off by default; set to 1 to enable step-by-step logs while developing on a
# device (mirrors the server's APP2APP_VERBOSE). Errors are always logged.
EXPO_PUBLIC_APP2APP_VERBOSE=0

# Optional iOS Build Number - increment for each App Store submission
IOS_BUILD_NUMBER=1
